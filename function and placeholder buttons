```html
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Opportunity Atlas | Opportunity Quest</title>

<style>

*{
box-sizing:border-box;
margin:0;
padding:0;
}

:root{
--bg:#071018;
--panel:#0d1821;
--panel2:#111f2b;
--line:#263b49;
--gold:#e4c46a;
--cyan:#61d7e8;
--blue:#69a9f5;
--green:#70d6a0;
--cream:#f5f1e7;
--muted:#9eacb7;
--red:#e78383;
--purple:#a98df5;
}

body{
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
background:
radial-gradient(circle at 10% 0%,rgba(97,215,232,.10),transparent 30%),
radial-gradient(circle at 90% 10%,rgba(228,196,106,.08),transparent 30%),
var(--bg);
color:var(--cream);
line-height:1.6;
}

.container{
width:min(1500px,94%);
margin:auto;
}

/* =========================
HERO
========================= */

.hero{
padding:65px 20px 45px;
border-bottom:1px solid var(--line);
}

.eyebrow{
color:var(--gold);
font-size:.72rem;
font-weight:900;
letter-spacing:.18em;
text-transform:uppercase;
margin-bottom:15px;
}

.hero h1{
font-size:clamp(2.8rem,6vw,6rem);
line-height:.96;
max-width:1100px;
margin-bottom:22px;
}

.hero h1 span{
color:var(--cyan);
}

.hero p{
max-width:900px;
font-size:1.08rem;
color:var(--muted);
}

/* =========================
GAME HUD
========================= */

.game-hud{
margin-top:30px;
display:grid;
grid-template-columns:2fr repeat(4,1fr);
gap:12px;
}

.hud-card{
background:rgba(13,24,33,.85);
border:1px solid var(--line);
border-radius:15px;
padding:16px;
}

.hud-card strong{
display:block;
font-size:1.65rem;
color:var(--cyan);
}

.hud-card span{
font-size:.65rem;
color:var(--muted);
text-transform:uppercase;
letter-spacing:.1em;
}

.level-card strong{
color:var(--gold);
}

/* XP */

.xp-wrap{
margin-top:10px;
}

.xp-top{
display:flex;
justify-content:space-between;
font-size:.7rem;
color:var(--muted);
}

.xp-bar{
height:9px;
background:#172832;
border-radius:20px;
overflow:hidden;
margin-top:5px;
}

.xp-fill{
height:100%;
width:0%;
background:linear-gradient(
90deg,
var(--gold),
var(--cyan)
);
transition:.6s ease;
}

/* =========================
DASHBOARD
========================= */

.dashboard{
padding:35px 0 80px;
}

.panel{
background:linear-gradient(145deg,var(--panel),#09131b);
border:1px solid var(--line);
border-radius:20px;
padding:25px;
margin-bottom:20px;
}

.panel h2{
color:var(--gold);
font-size:1.25rem;
margin-bottom:15px;
}

.panel-sub{
font-size:.82rem;
color:var(--muted);
margin-top:-7px;
margin-bottom:18px;
}

/* =========================
QUEST CENTER
========================= */

.quest-layout{
display:grid;
grid-template-columns:1.4fr 1fr;
gap:18px;
}

.quest{
background:#08141d;
border:1px solid var(--line);
border-radius:14px;
padding:17px;
margin-top:10px;
position:relative;
overflow:hidden;
}

.quest:before{
content:"";
position:absolute;
left:0;
top:0;
bottom:0;
width:3px;
background:var(--cyan);
}

.quest.complete{
border-color:rgba(112,214,160,.5);
background:#0c2019;
}

.quest.complete:before{
background:var(--green);
}

.quest-title{
font-weight:900;
font-size:.95rem;
}

.quest-description{
font-size:.77rem;
color:var(--muted);
margin-top:3px;
}

.quest-bottom{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:12px;
}

.quest-xp{
color:var(--gold);
font-size:.7rem;
font-weight:900;
}

button{
border:0;
border-radius:9px;
padding:10px 14px;
font-weight:900;
cursor:pointer;
font-size:.75rem;
transition:.2s;
}

button:hover{
transform:translateY(-1px);
filter:brightness(1.1);
}

.primary{
background:var(--cyan);
color:#061018;
}

.gold{
background:var(--gold);
color:#111;
}

.secondary{
background:#182a36;
color:var(--cream);
border:1px solid var(--line);
}

.danger{
background:#392121;
color:#ffb4b4;
}

/* =========================
JOURNEY
========================= */

.journey{
display:flex;
align-items:center;
gap:0;
margin-top:15px;
overflow-x:auto;
padding:10px 0 20px;
}

.journey-step{
min-width:125px;
text-align:center;
position:relative;
}

.journey-step:not(:last-child):after{
content:"";
position:absolute;
height:2px;
background:var(--line);
width:100%;
left:50%;
top:25px;
z-index:0;
}

.journey-node{
width:50px;
height:50px;
border-radius:50%;
background:#101e27;
border:2px solid var(--line);
display:flex;
align-items:center;
justify-content:center;
margin:auto;
position:relative;
z-index:2;
font-size:20px;
}

.journey-step.active .journey-node{
border-color:var(--cyan);
box-shadow:0 0 18px rgba(97,215,232,.25);
}

.journey-step.done .journey-node{
background:#173b2c;
border-color:var(--green);
}

.journey-label{
font-size:.67rem;
font-weight:800;
margin-top:7px;
}

.journey-small{
font-size:.6rem;
color:var(--muted);
}

/* =========================
DAILY CHALLENGE
========================= */

.challenge{
background:
linear-gradient(
135deg,
#1a233f,
#10192b
);
border:1px solid rgba(169,141,245,.4);
border-radius:17px;
padding:22px;
height:100%;
}

.challenge-label{
color:var(--purple);
font-size:.65rem;
font-weight:900;
letter-spacing:.15em;
text-transform:uppercase;
}

.challenge h3{
font-size:1.3rem;
margin:7px 0;
}

.challenge p{
font-size:.8rem;
color:#c3c9d7;
}

.challenge-reward{
margin-top:15px;
color:var(--gold);
font-weight:900;
font-size:.75rem;
}

/* =========================
SEARCH
========================= */

.search-area{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:12px;
align-items:end;
}

.field label{
display:block;
font-size:.68rem;
font-weight:900;
letter-spacing:.1em;
text-transform:uppercase;
color:var(--muted);
margin-bottom:7px;
}

input,
select{
width:100%;
background:#061018;
border:1px solid var(--line);
border-radius:10px;
padding:13px;
color:var(--cream);
font-size:.9rem;
outline:none;
}

input:focus,
select:focus{
border-color:var(--cyan);
}

/* =========================
CATEGORIES
========================= */

.category-grid{
display:grid;
grid-template-columns:repeat(6,1fr);
gap:10px;
}

.category{
background:#08141d;
border:1px solid var(--line);
border-radius:12px;
padding:14px;
cursor:pointer;
transition:.2s;
}

.category:hover{
border-color:var(--cyan);
transform:translateY(-2px);
}

.category.active{
border-color:var(--cyan);
background:#102633;
}

.category strong{
display:block;
font-size:.85rem;
}

.category span{
display:block;
font-size:.65rem;
color:var(--muted);
margin-top:4px;
}

/* =========================
OPPORTUNITIES
========================= */

.opportunity-header{
display:flex;
justify-content:space-between;
align-items:center;
gap:20px;
margin-bottom:17px;
}

.result-count{
font-size:.78rem;
color:var(--muted);
}

.opportunity-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.opportunity{
background:#08141d;
border:1px solid var(--line);
border-radius:17px;
padding:19px;
display:flex;
flex-direction:column;
min-height:310px;
transition:.2s;
}

.opportunity:hover{
border-color:rgba(97,215,232,.5);
transform:translateY(-2px);
}

.opportunity-top{
display:flex;
justify-content:space-between;
gap:10px;
margin-bottom:10px;
}

.tag{
font-size:.62rem;
font-weight:900;
letter-spacing:.1em;
text-transform:uppercase;
color:var(--gold);
}

.save{
background:none;
border:0;
padding:0;
font-size:1.25rem;
color:var(--muted);
cursor:pointer;
}

.save.saved{
color:var(--gold);
}

.opportunity h3{
font-size:1.1rem;
margin-bottom:8px;
}

.opportunity p{
font-size:.8rem;
color:var(--muted);
margin-bottom:13px;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:5px;
margin-bottom:14px;
}

.meta span{
font-size:.6rem;
padding:4px 7px;
border-radius:20px;
background:#132530;
color:#b7d9df;
}

.opportunity-footer{
margin-top:auto;
display:flex;
gap:7px;
}

.opportunity-footer a{
flex:1;
text-decoration:none;
text-align:center;
padding:10px;
border-radius:9px;
font-weight:900;
font-size:.73rem;
background:var(--cyan);
color:#061018;
}

.opportunity-footer button{
background:#172935;
color:var(--cream);
border:1px solid var(--line);
}

/* =========================
DISCOVERY
========================= */

.discovery{
display:grid;
grid-template-columns:1.5fr 1fr;
gap:18px;
}

.discovery-box{
background:
linear-gradient(145deg,#112632,#08141d);
border:1px solid rgba(97,215,232,.25);
border-radius:17px;
padding:22px;
}

.discovery-box h3{
color:var(--cyan);
margin-bottom:7px;
}

.discovery-box p{
color:var(--muted);
font-size:.83rem;
}

.path-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-top:17px;
}

.path{
background:#061018;
border:1px solid var(--line);
border-radius:11px;
padding:14px;
}

.path strong{
display:block;
font-size:.82rem;
}

.path span{
font-size:.68rem;
color:var(--muted);
}

/* =========================
WATCHLIST
========================= */

.watch-stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
margin-bottom:17px;
}

.watch-stat{
background:#08141d;
border:1px solid var(--line);
border-radius:12px;
padding:14px;
}

.watch-stat strong{
display:block;
font-size:1.5rem;
color:var(--cyan);
}

.watch-stat span{
font-size:.62rem;
color:var(--muted);
text-transform:uppercase;
}

/* =========================
TRACKER
========================= */

.tracker-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
}

.tracker-stat{
background:#08141d;
border:1px solid var(--line);
border-radius:12px;
padding:16px;
}

.tracker-stat strong{
display:block;
font-size:1.8rem;
color:var(--cyan);
}

.tracker-stat span{
font-size:.65rem;
color:var(--muted);
text-transform:uppercase;
}

.tracker-form{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:10px;
margin-top:20px;
}

.tracker-list{
margin-top:17px;
display:grid;
gap:8px;
}

.tracker-item{
display:grid;
grid-template-columns:2fr 1fr 1fr auto;
gap:10px;
align-items:center;
background:#08141d;
border:1px solid var(--line);
border-radius:10px;
padding:12px;
}

.tracker-item strong{
font-size:.8rem;
}

.tracker-item span{
font-size:.72rem;
color:var(--muted);
}

.status{
display:inline-block;
padding:4px 8px;
border-radius:20px;
font-size:.58rem;
font-weight:900;
text-transform:uppercase;
}

.researching{
background:#24352d;
color:#a9e8c5;
}

.preparing{
background:#30382d;
color:#e0dc98;
}

.applied{
background:#23334b;
color:#a9c9f4;
}

.rejected{
background:#422626;
color:#ffb2b2;
}

.won{
background:#263e2d;
color:#9ce6b7;
}

/* =========================
ACHIEVEMENTS
========================= */

.achievement-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
}

.achievement{
background:#08141d;
border:1px solid var(--line);
border-radius:12px;
padding:15px;
display:flex;
gap:10px;
align-items:center;
}

.achievement.locked{
opacity:.35;
}

.achievement-icon{
font-size:24px;
}

.achievement strong{
display:block;
font-size:.75rem;
}

.achievement span{
font-size:.63rem;
color:var(--muted);
}

/* =========================
WARNING
========================= */

.warning{
padding:18px;
border-left:3px solid var(--gold);
background:#101b20;
border-radius:9px;
}

.warning h3{
color:var(--gold);
font-size:.95rem;
margin-bottom:4px;
}

.warning p{
color:var(--muted);
font-size:.78rem;
}

/* =========================
NOTIFICATION
========================= */

#notification{
position:fixed;
right:20px;
bottom:20px;
background:#111f2b;
border:1px solid var(--cyan);
color:white;
padding:15px 19px;
border-radius:12px;
box-shadow:0 15px 35px rgba(0,0,0,.4);
opacity:0;
transform:translateY(20px);
pointer-events:none;
transition:.3s;
z-index:9999;
font-size:.8rem;
font-weight:800;
}

#notification.show{
opacity:1;
transform:translateY(0);
}

/* =========================
FOOTER
========================= */

footer{
border-top:1px solid var(--line);
padding:40px 20px;
text-align:center;
color:var(--muted);
font-size:.8rem;
}

/* =========================
RESPONSIVE
========================= */

@media(max-width:1100px){

.game-hud{
grid-template-columns:repeat(3,1fr);
}

.search-area{
grid-template-columns:1fr 1fr;
}

.category-grid{
grid-template-columns:repeat(3,1fr);
}

.opportunity-grid{
grid-template-columns:1fr 1fr;
}

.quest-layout,
.discovery{
grid-template-columns:1fr;
}

.path-grid{
grid-template-columns:1fr 1fr;
}

.achievement-grid{
grid-template-columns:1fr 1fr;
}

}

@media(max-width:700px){

.hero{
padding-top:45px;
}

.game-hud{
grid-template-columns:1fr 1fr;
}

.search-area,
.tracker-form{
grid-template-columns:1fr;
}

.category-grid,
.opportunity-grid,
.path-grid,
.achievement-grid{
grid-template-columns:1fr;
}

.watch-stats,
.tracker-grid{
grid-template-columns:1fr 1fr;
}

.tracker-item{
grid-template-columns:1fr;
}

}

</style>
</head>


<body>


<!-- =========================
HERO
========================= -->

<section class="hero">

<div class="container">

<div class="eyebrow">
OPPORTUNITY QUEST / ATLAS
</div>

<h1>
Don't wait for one opportunity.<br>
<span>Build an opportunity pipeline.</span>
</h1>

<p>
Search beyond traditional jobs. Discover programs, funding,
fellowships, residencies, scholarships, accelerators, mentorships,
international pathways and other routes that can change your trajectory.
</p>


<!-- GAME HUD -->

<div class="game-hud">

<div class="hud-card level-card">

<strong id="levelText">
Level 1
</strong>

<span id="rankText">
Opportunity Scout
</span>

<div class="xp-wrap">

<div class="xp-top">

<span>Progress</span>

<span id="xpText">
0 / 100 XP
</span>

</div>

<div class="xp-bar">
<div
class="xp-fill"
id="xpFill">
</div>
</div>

</div>

</div>


<div class="hud-card">

<strong id="scoreText">
0
</strong>

<span>
Opportunity Score
</span>

</div>


<div class="hud-card">

<strong id="streakText">
0
</strong>

<span>
Search Streak
</span>

</div>


<div class="hud-card">

<strong id="savedText">
0
</strong>

<span>
Watchlist
</span>

</div>


<div class="hud-card">

<strong id="appliedText">
0
</strong>

<span>
Applications
</span>

</div>

</div>

</div>

</section>


<main class="dashboard">

<div class="container">


<!-- =========================
QUEST CENTER
========================= -->

<section class="panel">

<h2>
🎮 Your Opportunity Quest
</h2>

<p class="panel-sub">
The goal isn't to collect links. The goal is to move opportunities
from discovery → research → preparation → application → outcome.
</p>


<div class="quest-layout">


<div>

<div class="quest" id="questSearch">

<div class="quest-title">
🔎 Explorer Quest
</div>

<div class="quest-description">
Search the Atlas for an opportunity you have never considered before.
</div>

<div class="quest-bottom">

<span class="quest-xp">
+15 XP
</span>

<button
class="primary"
onclick="completeQuest('search',15)">
Complete
</button>

</div>

</div>


<div class="quest" id="questSave">

<div class="quest-title">
⭐ Build Your Watchlist
</div>

<div class="quest-description">
Save 3 opportunities that could become useful in the future.
</div>

<div class="quest-bottom">

<span class="quest-xp">
+25 XP
</span>

<button
class="primary"
onclick="completeQuest('save',25)">
Complete
</button>

</div>

</div>


<div class="quest" id="questTrack">

<div class="quest-title">
📬 Build Your Pipeline
</div>

<div class="quest-description">
Put at least one opportunity into your application tracker.
</div>

<div class="quest-bottom">

<span class="quest-xp">
+30 XP
</span>

<button
class="primary"
onclick="completeQuest('track',30)">
Complete
</button>

</div>

</div>


<div class="quest" id="questExplore">

<div class="quest-title">
🧭 Leave Your Comfort Zone
</div>

<div class="quest-description">
Explore three different opportunity categories.
</div>

<div class="quest-bottom">

<span class="quest-xp">
+35 XP
</span>

<button
class="primary"
onclick="completeQuest('categories',35)">
Complete
</button>

</div>

</div>

</div>


<div class="challenge">

<div class="challenge-label">
Daily Opportunity Challenge
</div>

<h3>
🎲 Find a Path You Didn't Know Existed
</h3>

<p>
Use the search engine to investigate one pathway you would not
normally search for: residency, fellowship, accelerator, mobility,
grant, mentorship or another category outside your normal strategy.
</p>

<div class="challenge-reward">
REWARD: +40 XP
</div>

<button
class="gold"
onclick="dailyChallenge()"
style="margin-top:15px;">

I Did It

</button>

</div>

</div>

</section>


<!-- =========================
JOURNEY
========================= -->

<section class="panel">

<h2>
🗺️ Opportunity Journey
</h2>

<p class="panel-sub">
Every opportunity should move through a progression.
</p>

<div class="journey">

<div class="journey-step active">
<div class="journey-node">🔎</div>
<div class="journey-label">Discover</div>
<div class="journey-small">Find possibilities</div>
</div>

<div class="journey-step">
<div class="journey-node">⭐</div>
<div class="journey-label">Save</div>
<div class="journey-small">Build your watchlist</div>
</div>

<div class="journey-step">
<div class="journey-node">🧠</div>
<div class="journey-label">Research</div>
<div class="journey-small">Check eligibility</div>
</div>

<div class="journey-step">
<div class="journey-node">🛠️</div>
<div class="journey-label">Prepare</div>
<div class="journey-small">Build your evidence</div>
</div>

<div class="journey-step">
<div class="journey-node">📬</div>
<div class="journey-label">Apply</div>
<div class="journey-small">Take action</div>
</div>

<div class="journey-step">
<div class="journey-node">🏆</div>
<div class="journey-label">Outcome</div>
<div class="journey-small">Learn + advance</div>
</div>

</div>

</section>


<!-- =========================
SEARCH
========================= -->

<section class="panel">

<h2>
01 / Opportunity Discovery Engine
</h2>

<div class="search-area">

<div class="field">

<label>Search</label>

<input
id="search"
placeholder="startup, scholarship, remote, Europe..."
oninput="filterOpportunities()">

</div>


<div class="field">

<label>Category</label>

<select
id="categoryFilter"
onchange="filterOpportunities()">

<option value="all">
All Categories
</option>

<option value="Residency">
Residency
</option>

<option value="Startup">
Startup
</option>

<option value="Accelerator">
Accelerator
</option>

<option value="Funding">
Funding
</option>

<option value="Scholarship">
Scholarship
</option>

<option value="Fellowship">
Fellowship
</option>

<option value="Mentorship">
Mentorship
</option>

<option value="Internship">
Internship
</option>

<option value="Volunteering">
Volunteering
</option>

<option value="Education">
Education
</option>

<option value="Technology">
Technology
</option>

<option value="Mobility">
Mobility
</option>

</select>

</div>


<div class="field">

<label>Pathway</label>

<select
id="typeFilter"
onchange="filterOpportunities()">

<option value="all">
Everything
</option>

<option value="funded">
Funding / Financial
</option>

<option value="career">
Career / Experience
</option>

<option value="global">
International
</option>

<option value="business">
Business Building
</option>

<option value="learning">
Learning
</option>

</select>

