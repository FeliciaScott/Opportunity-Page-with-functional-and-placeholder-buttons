notify(
"✓ Quest already completed."
);

return;

}

if(
type === "save"
&&
game.saved.length < 3
){

notify(
"⭐ Save at least 3 opportunities first."
);

return;

}

if(
type === "track"
&&
game.applications.length < 1
){

notify(
"📬 Track at least one opportunity first."
);

return;

}

if(
type === "categories"
&&
game.exploredCategories.length < 3
){

notify(
"🧭 Explore 3 categories first."
);

return;

}

game.completedQuests.push(type);

addXP(
xp,
"Quest complete"
);

update();

}


